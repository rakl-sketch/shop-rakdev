# Browser-safe Supabase values only. Never put service role / secret keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Opsional: VAPID public key untuk Web Push (pasangan VAPID_PRIVATE_KEY di Edge Function secrets).
VITE_VAPID_PUBLIC_KEY=
# UI QRIS nonaktif secara default. Set true hanya setelah secrets BuatQris siap dan diuji.
VITE_QRIS_ENABLED=false

# BuatQris TIDAK memakai VITE_*.
# Set kredensial berikut lewat `supabase secrets set` (server-side saja):
# BUATQRIS_ACCOUNT_ID, BUATQRIS_SECRET_TOKEN, BUATQRIS_WEBHOOK_SECRET,
# BUATQRIS_MODE=sandbox|production, BUATQRIS_QRIS_METHOD, BUATQRIS_UMKM_NAME
